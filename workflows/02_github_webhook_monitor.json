{
  "name": "GitHub Webhook Monitor",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "github-events",
        "options": {}
      },
      "id": "webhook-github",
      "name": "GitHub Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.headers['x-github-event'] }}",
                    "rightValue": "push",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Push Event"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.headers['x-github-event'] }}",
                    "rightValue": "issues",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Issue Event"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.headers['x-github-event'] }}",
                    "rightValue": "pull_request",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "PR Event"
            }
          ]
        },
        "options": {}
      },
      "id": "switch-event",
      "name": "Route by Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "push-type",
              "name": "event_type",
              "value": "push",
              "type": "string"
            },
            {
              "id": "push-repo",
              "name": "repository",
              "value": "={{ $json.body.repository.full_name }}",
              "type": "string"
            },
            {
              "id": "push-branch",
              "name": "branch",
              "value": "={{ $json.body.ref }}",
              "type": "string"
            },
            {
              "id": "push-pusher",
              "name": "pusher",
              "value": "={{ $json.body.pusher.name }}",
              "type": "string"
            },
            {
              "id": "push-commits",
              "name": "commit_count",
              "value": "={{ $json.body.commits.length }}",
              "type": "number"
            },
            {
              "id": "push-message",
              "name": "latest_commit_message",
              "value": "={{ $json.body.head_commit.message }}",
              "type": "string"
            },
            {
              "id": "push-timestamp",
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "format-push",
      "name": "Format Push Event",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [740, 160]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "issue-type",
              "name": "event_type",
