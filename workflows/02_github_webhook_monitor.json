              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "format-issue",
      "name": "Format Issue Event",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [740, 340]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "pr-type",
              "name": "event_type",
              "value": "pull_request",
              "type": "string"
            },
            {
              "id": "pr-action",
              "name": "action",
              "value": "={{ $json.body.action }}",
              "type": "string"
            },
            {
              "id": "pr-repo",
              "name": "repository",
              "value": "={{ $json.body.repository.full_name }}",
              "type": "string"
            },
            {
              "id": "pr-title",
              "name": "pr_title",
              "value": "={{ $json.body.pull_request.title }}",
              "type": "string"
            },
            {
              "id": "pr-user",
              "name": "user",
              "value": "={{ $json.body.pull_request.user.login }}",
              "type": "string"
            },
            {
              "id": "pr-url",
              "name": "pr_url",
              "value": "={{ $json.body.pull_request.html_url }}",
              "type": "string"
            },
            {
              "id": "pr-timestamp",
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "format-pr",
      "name": "Format PR Event",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [740, 520]
    },
    {
      "parameters": {
        "functionCode": "const items = $input.all();\nconst event = items[0].json;\n\nlet message = '';\nswitch(event.event_type) {\n  case 'push':\n    message = `🔀 Push to ${event.repository}\\nBranch: ${event.branch}\\nBy: ${event.pusher}\\nCommits: ${event.commit_count}\\nMessage: ${event.latest_commit_message}`;\n    break;\n  case 'issue':\n    message = `📋 Issue ${event.action}: ${event.issue_title}\\nRepo: ${event.repository}\\nBy: ${event.user}\\nURL: ${event.issue_url}`;\n    break;\n  case 'pull_request':\n    message = `🔃 PR ${event.action}: ${event.pr_title}\\nRepo: ${event.repository}\\nBy: ${event.user}\\nURL: ${event.pr_url}`;\n    break;\n}\n\nreturn [{ json: { ...event, notification_message: message } }];"
      },
      "id": "build-notification",
      "name": "Build Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 340]
    }
  ],
